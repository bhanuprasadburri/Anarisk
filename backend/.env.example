# ---- Copy to .env and edit. Never commit .env ----
ENVIRONMENT=development            # development | test | production
DEBUG=false

# PostgreSQL (docker-compose uses these same defaults)
DATABASE_URL=postgresql+psycopg://nimbus:nimbus_dev_pw@localhost:5432/nimbus
TEST_DATABASE_URL=postgresql+psycopg://nimbus:nimbus_dev_pw@localhost:5432/nimbus_test

# JWT: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app REFUSES to start with the placeholder or a key shorter than 32 chars.
SECRET_KEY=change-me-in-production-this-is-only-a-development-placeholder
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public self-registration creates a role=brand_owner account with NO organization (no data access
# until an administrator assigns one). Set false to disable the endpoint entirely.
ALLOW_PUBLIC_REGISTRATION=true

# Seed script bootstrap admin (used only by scripts/seed.py)
BOOTSTRAP_ADMIN_EMAIL=admin@nimbus.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-123

# Scoring (weights are normalised to sum to 1 at startup)
WEIGHT_BRAND_LOGO=0.30
WEIGHT_IMPERSONATION=0.30
WEIGHT_URL_RISK=0.25
WEIGHT_BEHAVIOR=0.15

# Outbound URL inspection is OFF by default. Enable only behind an egress firewall.
URL_FETCH_ENABLED=false

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_ENABLED=true
